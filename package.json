{
  "name": "hofstadter-interactive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "test:pyodide": "node scripts/pyodide-parity.mjs",
    "check:fast": "npm test && npm run typecheck",
    "check:smoke": "npm run check:fast && npm run test:e2e:smoke",
    "check:release": "npm run check:fast && npm run python:test && npm run test:pyodide && npm run build && npm run test:e2e",
    "audit:physics": ".venv/bin/python scripts/physics-audit.py",
    "audit:accessibility": "node scripts/accessibility-audit.mjs",
    "audit:report": "npm run audit:physics && npm run audit:accessibility && node scripts/build-audit-report.mjs",
    "python:test": ".venv/bin/python -m pytest -q",
    "python:wheel": ".venv/bin/python -m build --no-isolation --wheel --outdir public/python",
    "assets:pyodide": "node scripts/copy-pyodide.mjs",
    "prepare:static": "npm run python:wheel && npm run assets:pyodide",
    "benchmark": ".venv/bin/python scripts/benchmark.py",
    "benchmark:browser": "node scripts/benchmark-browser.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "comlink": "4.4.2",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "d3-zoom": "3.0.0",
    "fflate": "0.8.2",
    "pyodide": "314.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.7",
    "@types/d3-zoom": "3.0.8",
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
